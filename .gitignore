# Binaries and vendor payloads — never commit
research/**/*.exe
*.sys
*.dll
*.cat
*.tar.gz
*.zip
*.7z
*.bin
*.pcap
*.pcapng
*.dmp
*.log
# verifier evidence logs are machine-checkable citations for VERDICTS.md — keep them tracked
!research/**/evidence/*.log

# Decompiled vendor pseudocode stays local-only; reports describe findings instead
research/**/pseudocode/

# Secrets — never commit
.env
*.key
*.pem

# Python caches
__pycache__/
.pytest_cache/

# Research reports (*.md, *.json, *.txt, *.csv) stay tracked on purpose.

# Dynamic-lab captures are evidence (dummy test data, no credentials)
!research/60-dynamic/captures/*.bin
!research/60-dynamic/captures/*.log
