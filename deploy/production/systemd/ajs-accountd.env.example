# Environment for ajs-accountd under systemd.
#
# Install as /etc/ajs/accountd.env, root-owned mode 0600. systemd reads this
# file as root before dropping to User=ajs. This example contains placeholders
# only; generate real values on the host and never commit them.
#
# /etc/ajs is root:<daemon group> 0750 so the daemon can traverse it to read
# its root:<daemon group> 0640 operator-hash file. The default group is `ajs`;
# if this unit uses a different Group=, pass the same group to the renderer as
# AJS_DAEMON_GROUP (and to install -g below). accountd.env itself stays 0600
# root:root because systemd reads it as root.
#
#   sudo install -d -m 0750 -o root -g ajs /etc/ajs
#   sudo install -m 0600 -o root -g root deploy/production/systemd/ajs-accountd.env.example /etc/ajs/accountd.env
#   sudo -e /etc/ajs/accountd.env

# --- listener and state -------------------------------------------------------
AJS_LISTEN=127.0.0.1:2261
AJS_STATE_DIR=/var/lib/ajs
AJS_LOG_LEVEL=info

# --- admin authentication and RBAC ------------------------------------------
# No AJS_ADMIN_TOKEN is needed in strict mode. During migration only, retain
# the existing >=32-character shared bearer until cutover is verified.
# Strict mode accepts per-operator tokens and machine scoped keys only; it
# never accepts this legacy shared bearer or AJS_ALLOW_INSECURE=1.
AJS_RBAC_STRICT=1
AJS_ADMIN_OPERATORS_FILE=/etc/ajs/admin-operators.hashes

# --- at-rest sealing ----------------------------------------------------------
# 64 hex characters (32 bytes) for AES-256-GCM account-password sealing.
# Losing this key makes existing sealed values unrecoverable.
AJS_MASTER_KEY=

# --- customer portal (OFF in v0.1.0-pre) --------------------------------------
# The portal, orders and payment surfaces are experimental and disabled in this
# release. Keep AJS_TENANT_PORTAL=0: the daemon then registers none of
# /v1/portal/*, /v1/admin/tenants*, /v1/admin/orders* or /v1/admin/plans*, and
# every one of them answers 404. Enabling it requires AJS_TENANT_ORIGIN and the
# non-product portal vhost, and is a product decision, not an install step.
# See docs/EPAY-STATUS.md.
AJS_TENANT_PORTAL=0
#AJS_TENANT_ORIGIN=https://panel.example.com
# Only nginx may supply X-Forwarded-For. Keep this to loopback. The same
# loopback nginx performs per-operator Basic auth and maps the operator token.
# The daemon derives identity/role from that token, not X-AJS-Operator.
AJS_TRUSTED_PROXIES=127.0.0.1,::1
# Browser origins allowed to call the admin API. The admin origin is not a
# browser CORS caller (same-origin through nginx); keep this empty or set the
# exact admin origin only if a separate browser client exists.
AJS_CORS_ORIGINS=
# Exact browser origin of the admin SPA. Unsafe admin requests carrying an
# Origin header must match this value; requests without Origin (CLI/SDK) must
# still send X-AJS-CSRF: 1. The template serves the admin UI on port 8443.
AJS_ADMIN_ORIGINS=https://admin.example.com:8443

# --- optional TLS admin listener ---------------------------------------------
# Not used when nginx terminates TLS; leave all three empty/unset. The
# plaintext listener stays on loopback behind nginx.
#AJS_TLS_CERT=/etc/ajs/tls/admin.example.com/fullchain.pem
#AJS_TLS_KEY=/etc/ajs/tls/admin.example.com/privkey.pem
#AJS_TLS_LISTEN=127.0.0.1:2262

# --- public gate data plane ---------------------------------------------------
# AJS_GATE_HTTP=1 starts the per-node HTTP CONNECT listener on
# 127.0.0.1:(gatePort + AJS_GATE_HTTP_OFFSET), beside the SOCKS5 gate that
# stays on 127.0.0.1:13000+. The nginx stream map in
# nginx/streams-available/ajs-gate.conf publishes that listener as TLS on
# 13000-13010 -> 14000-14010, so the offset must stay 1000: any other value
# points the public edge at a closed port. Unset or 0 keeps the HTTP listener
# off (the SOCKS5 gate still runs); any other value aborts startup.
AJS_GATE_HTTP=1
AJS_GATE_HTTP_OFFSET=1000

# --- optional: Resin integration ---------------------------------------------
# Empty AJS_RESIN_ADMIN_TOKEN disables the integration.
AJS_RESIN_URL=http://127.0.0.1:2260
AJS_RESIN_ADMIN_TOKEN=

# --- optional: epay / Stripe (EXPERIMENTAL, off in v0.1.0-pre) ----------------
# Leave empty. These adapters are experimental and have no order surface while
# AJS_TENANT_PORTAL=0; no route charges a card. Re-enabling requires the review
# in docs/EPAY-STATUS.md. The notify/return URLs are derived from
# AJS_TENANT_ORIGIN when empty.
#AJS_EPAY_GATEWAY=https://pay.example.com/
#AJS_EPAY_PID=
#AJS_EPAY_KEY=
#AJS_EPAY_SIGN_TYPE=MD5
#AJS_EPAY_NOTIFY_URL=https://panel.example.com/v1/payments/epay/notify
#AJS_EPAY_RETURN_URL=https://panel.example.com/portal
#AJS_STRIPE_WEBHOOK_SECRET=

# --- optional: state / logging ------------------------------------------------
#AJS_STATE_FILE=/var/lib/ajs/state.json
#AJS_SNAPSHOT_INTERVAL=30s
AJS_FLOW_METER=1

# --- vendor login (opt-in; leave off until an account is configured) ---------
AJS_ACCOUNT_LOGIN=0
#AJS_CONTROL_CERT_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
