# Environment for ajs-accountd under systemd.
#
# Install as /etc/ajs/accountd.env, root-owned mode 0600. systemd reads this
# file as root before dropping to User=ajs. This example contains placeholders
# only; generate real values on the host and never commit them.
#
#   sudo install -d -m 0750 -o root -g root /etc/ajs
#   sudo install -m 0600 -o root -g root deploy/production/systemd/ajs-accountd.env.example /etc/ajs/accountd.env
#   sudo -e /etc/ajs/accountd.env

# --- listener and state -------------------------------------------------------
AJS_LISTEN=127.0.0.1:2261
AJS_STATE_DIR=/var/lib/ajs
AJS_LOG_LEVEL=info

# --- admin bearer -------------------------------------------------------------
# Required unless AJS_ALLOW_INSECURE=1 (loopback lab only). At least 32 chars;
# generate with `openssl rand -hex 32`. The same value must be rendered into
# /etc/nginx/snippets/ajs-admin-token.conf by render-admin-token.sh.
AJS_ADMIN_TOKEN=replace-me-with-openssl-rand-hex-32

# --- at-rest sealing ----------------------------------------------------------
# 64 hex characters (32 bytes) for AES-256-GCM account-password sealing.
# Losing this key makes existing sealed values unrecoverable.
AJS_MASTER_KEY=

# --- customer portal ----------------------------------------------------------
# Enable the /v1/portal/* chain. AJS_TENANT_ORIGIN must be the exact public
# portal origin (scheme + host, no path), matching the nginx server_name.
AJS_TENANT_PORTAL=1
AJS_TENANT_ORIGIN=https://panel.example.com
# Only nginx may supply X-Forwarded-For. Keep this to loopback. The same
# loopback nginx performs per-operator Basic auth and supplies X-AJS-Operator
# as an audit label; the daemon still requires AJS_ADMIN_TOKEN on every call.
AJS_TRUSTED_PROXIES=127.0.0.1,::1
# Browser origins allowed to call the admin API. The admin origin is not a
# browser CORS caller (same-origin through nginx); keep this empty or set the
# exact admin origin only if a separate browser client exists.
AJS_CORS_ORIGINS=
# Exact browser origin of the admin SPA. Unsafe admin requests carrying an
# Origin header must match this value; requests without Origin (CLI/SDK) must
# still send X-AJS-CSRF: 1. The template serves the admin UI on port 8443.
AJS_ADMIN_ORIGINS=https://admin.example.com:8443

# --- optional TLS admin listener ---------------------------------------------
# Not used when nginx terminates TLS; leave all three empty/unset. The
# plaintext listener stays on loopback behind nginx.
#AJS_TLS_CERT=/etc/ajs/tls/admin.example.com/fullchain.pem
#AJS_TLS_KEY=/etc/ajs/tls/admin.example.com/privkey.pem
#AJS_TLS_LISTEN=127.0.0.1:2262

# --- optional: Resin integration ---------------------------------------------
# Empty AJS_RESIN_ADMIN_TOKEN disables the integration.
AJS_RESIN_URL=http://127.0.0.1:2260
AJS_RESIN_ADMIN_TOKEN=

# --- optional: epay / Stripe --------------------------------------------------
# Leave empty unless a real provider is configured. The notify/return URLs are
# derived from AJS_TENANT_ORIGIN when empty.
#AJS_EPAY_GATEWAY=https://pay.example.com/
#AJS_EPAY_PID=
#AJS_EPAY_KEY=
#AJS_EPAY_SIGN_TYPE=MD5
#AJS_EPAY_NOTIFY_URL=https://panel.example.com/v1/payments/epay/notify
#AJS_EPAY_RETURN_URL=https://panel.example.com/portal
#AJS_STRIPE_WEBHOOK_SECRET=

# --- optional: state / logging ------------------------------------------------
#AJS_STATE_FILE=/var/lib/ajs/state.json
#AJS_SNAPSHOT_INTERVAL=30s
AJS_FLOW_METER=1

# --- vendor login (opt-in; leave off until an account is configured) ---------
AJS_ACCOUNT_LOGIN=0
#AJS_CONTROL_CERT_SHA256=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99
