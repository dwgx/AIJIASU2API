# Control-plane environment for deploy/compose.yml.
#
# Copy this file and replace every placeholder:
#
#   cp .env.example .env
#   openssl rand -hex 32        # AJS_MASTER_KEY
#
# This file holds no real credentials. .env is listed in .gitignore; never
# commit a filled-in copy. All values are loopback-only: ajs-accountd and Resin
# run with host networking and bind 127.0.0.1, and the dashboard is published on
# 127.0.0.1:18081.

# --- ajs-accountd -----------------------------------------------------------
# Bearer token for every /v1/* call. The dashboard bundle embeds
# VITE_PANEL_TOKEN, so this is a loopback placeholder, not a production secret:
# terminate real authentication in a BFF or reverse proxy.
AJS_ADMIN_TOKEN=change-me
# 32-byte AES-256-GCM key for account-password sealing, as 64 hex characters.
# Generate with: openssl rand -hex 32
# Leave empty to disable at-rest sealing (account passwords are then discarded).
AJS_MASTER_KEY=
# Browser origin allowed to call the API: the dashboard published on 18081.
# Add http://127.0.0.1:18082 when using the standalone vite preview live build.
AJS_CORS_ORIGINS=http://127.0.0.1:18081

# --- Resin integration ------------------------------------------------------
# Empty AJS_RESIN_ADMIN_TOKEN disables the integration; the daemon then serves
# the store-only panel contract.
AJS_RESIN_URL=http://127.0.0.1:2260
AJS_RESIN_ADMIN_TOKEN=

# --- dashboard build --------------------------------------------------------
# Vite bakes these into the bundle at image build time; changing them requires
# `docker compose build dashboard`.
# true  = deterministic in-browser mock data, no backend.
# false = live mode against VITE_API_BASE. VITE_PANEL_TOKEN is readable by
#         anyone who can fetch the bundle, so live mode stays on loopback.
VITE_USE_MOCK=true
VITE_API_BASE=http://127.0.0.1:2261
VITE_PANEL_TOKEN=change-me

# --- Resin service (resin profile) ------------------------------------------
# Admin token for the Resin admin API on 127.0.0.1:2260. Must match
# AJS_RESIN_ADMIN_TOKEN above for the daemon's Resin integration to work.
RESIN_ADMIN_TOKEN=
# SOCKS5 credential Resin expects from proxy clients.
RESIN_PROXY_TOKEN=
