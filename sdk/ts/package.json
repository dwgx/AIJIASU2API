{
  "name": "@ajs/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free TypeScript client for the ajs-accountd admin API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
